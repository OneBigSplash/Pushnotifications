{
    "Serilog": {
        "Using": [ "Elastic.Serilog.Sinks" ],
        "MinimumLevel": {
            // Verbose | Debug | Information | Warning | Error | Fatal
            "Default": "Information",
            "Override": {
                "Elders": "Information",
                "Microsoft": "Information",
                "Microsoft.AspNetCore": "Warning",
                "System": "Information",
                "PushNotifications.Ports": "Debug"
            }
        },
        "WriteTo": [
            {
                // https://www.elastic.co/docs/reference/ecs/logging/dotnet/serilog-data-shipper
                "Name": "Elasticsearch",
                "Args": {
                    "nodes": [ "%log_server%" ],
                    "dataStream": "logs-elders.pushnotifications-int",
                    "bootstrapMethod": "Failure"
                }
            }
        ]
    }
}
