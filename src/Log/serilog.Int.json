{
    "Serilog": {
        "Using": [ "Serilog.Sinks.File" ],
        "MinimumLevel": {
            // Verbose | Debug | Information | Warning | Error | Fatal
            "Default": "Information",
            "Override": {
                "Elders": "Information",
                "Microsoft": "Information",
                "Microsoft.AspNetCore": "Warning",
                "System": "Information",
                "PushNotifications.Ports": "Debug"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "logs/%log_name%-int-.log",
                    "rollingInterval": "Day",
                    "fileSizeLimitBytes": 104857600,
                    "rollOnFileSizeLimit": true,
                    "retainedFileCountLimit": 14,
                    "buffered": false,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{Application}] [{MachineName}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}"
                    }
            }
        ]
    }
}
