{
    "Serilog": {
        "MinimumLevel": {
            // Verbose | Debug | Information | Warning | Error | Fatal
            "Default": "Debug",
            "Override": {
                "Elders": "Information",
                "Microsoft": "Information",
                "Microsoft.AspNetCore": "Warning",
                "System": "Information"
            }
        },
        "WriteTo": [
            { "Name": "Debug" },
            {
                "Name": "Console",
                "Args": {
                    "theme": "Log.EldersThemes::Epic, Log"
                }
            }
            //,{
            //    "Name": "File",
            //    "Args": {
            //        "path": "%PROGRAMDATA%\\.logs\\%pandora_application%\\log.txt",
            //        "rollingInterval": "Day"
            //    }
            //},
        ]
    }
}
