{
    "Serilog": {
        "MinimumLevel": {
            // Verbose | Debug | Information | Warning | Error | Fatal
            "Default": "Debug",
            "Override": {
                "Elders": "Information",
                "Microsoft": "Information",
                "Microsoft.AspNetCore": "Warning",
                "System": "Information"
            }
        },
        "WriteTo": [
            { "Name": "Debug" },
            {
                "Name": "Console",
                "Args": {
                    "theme": "Log.EldersThemes::Epic, Log"
                }
            }
        ]
    }
}
