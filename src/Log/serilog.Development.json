{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "One": "Information",
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Information",
        "Elders": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Debug"
      },
      {
        "Name": "Console",
        "Args": {
          "theme": "Log.EldersThemes::Epic, Log"
        }
      }
    ]
  }
}
